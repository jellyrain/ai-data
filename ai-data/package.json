{
  "name": "ai-data",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "dev:web": "pnpm --filter @ai-data/web dev",
    "dev:api": "pnpm --filter @ai-data/api dev",
    "dev:data-access": "pnpm --filter @ai-data/data-access dev",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint eslint.config.mjs scripts && pnpm -r lint",
    "test": "pnpm run test:engineering && pnpm -r test",
    "test:engineering": "node --test scripts/tests/*.test.mjs",
    "test:integration": "pnpm --filter @ai-data/api --filter @ai-data/data-access test:integration",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "pnpm -r build",
    "release": "node scripts/prepare-release.mjs",
    "test:release": "node scripts/test-release.mjs"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "prettier": "catalog:",
    "typescript-eslint": "catalog:"
  }
}
