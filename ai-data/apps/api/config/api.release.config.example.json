{
  "node_env": "production",
  "service": {
    "host": "127.0.0.1",
    "port": 3101,
    "service_id": "ai-bi-api",
    "service_version": "1.0.0"
  },
  "metadata_sqlserver": {
    "server": "127.0.0.1",
    "port": 1433,
    "database": "ai_bi_meta",
    "user": "api_service",
    "password": "replace-with-metadata-database-password",
    "options": {
      "encrypt": true,
      "trust_server_certificate": false,
      "connection_timeout_ms": 5000,
      "request_timeout_ms": 10000,
      "pool": {
        "max": 10,
        "min": 0,
        "idle_timeout_ms": 30000
      }
    }
  },
  "trusted_data_access_services": [
    {
      "service_id": "data-access-service",
      "credential_version": 1,
      "enabled": true
    }
  ],
  "jwt": {
    "issuer": "ai-data-api",
    "audience": "ai-data-api",
    "access_token_ttl_seconds": 900
  },
  "bootstrap_admin": {
    "organization_id": "organization-001",
    "organization_code": "default",
    "organization_name": "默认组织",
    "username": "admin",
    "display_name": "系统管理员",
    "password": "replace-with-initial-admin-password"
  },
  "analysis_runtime": {
    "enabled": false,
    "state_directory": "secrets/codex-runtime",
    "concurrency": 2,
    "poll_ms": 1000,
    "skills_directory": "skills"
  }
}
