  {
    "name": "指定时间在院人次",
    "sql": "SELECT COUNT(DISTINCT admission_id) AS inpatients FROM dbo.admissions WHERE admitted_at<='2026-09-27 18:00:00' AND (discharged_at IS NULL OR discharged_at>'2026-09-27 18:00:00')",
    "query": {
      "type": "relational_query",
      "source_id": "clinical-demo",
      "from": {
        "object_id": "table.dbo.admissions",
        "alias": "a"
      },
      "select": [
        {
          "field": "a.admission_id",
          "as": "inpatients",
          "aggregation": "count_distinct"
        }
      ],
      "filters": {
        "logic": "and",
        "items": [
          {
            "field": "a.admitted_at",
            "op": "between",
            "data_type": "datetime",
            "value": [
              "1900-01-01 00:00:00",
              "2026-09-27 18:00:00"
            ]
          },
          {
            "logic": "or",
            "items": [
              {
                "field": "a.discharged_at",
                "op": "is_null",
                "data_type": "datetime"
              },
              {
                "field": "a.discharged_at",
                "op": "between",
                "data_type": "datetime",
                "value": [
                  "2026-09-27 18:00:01",
                  "9999-12-31 23:59:59"
