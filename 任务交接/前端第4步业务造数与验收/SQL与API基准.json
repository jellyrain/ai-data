        "logic": "and",
        "items": [
          {
            "field": "r.registered_at",
            "op": "between",
            "data_type": "datetime",
            "value": [
              "2026-09-01 00:00:00",
              "2026-09-27 23:59:59"
            ]
          },
          {
            "field": "v.status",
