      {
        "metric_id": "demo-inpatient-fees",
        "version": 2,
        "name": "住院有效费用（费用发生时间）",
        "description": "clinical-demo 演示指标，按 charged_at 过滤日期；金额单位为分，包含费用冲销负数，展示元时除以100。可按 c.name 费用分类或 d.name 科室分组，总计在完整授权范围重新计算。",
        "aliases": [
          "住院费用"
        ],
        "grain": "inpatient_charge_details",
        "deduplication_keys": [
          "t.charge_id"
        ],
        "date_basis": {
          "field": "t.charged_at",
          "data_type": "datetime"
        },
        "query": {
          "type": "relational_query",
          "source_id": "clinical-demo",
          "from": {
            "object_id": "table.dbo.inpatient_charge_details",
            "alias": "t"
          },
          "joins": [
            {
              "type": "inner",
              "object_id": "table.dbo.departments",
              "alias": "d",
              "on": [
                {
                  "left": "t.department_id",
                  "op": "eq",
                  "right": "d.department_id"
                }
              ]
            },
            {
              "type": "inner",
              "object_id": "table.dbo.charge_items",
              "alias": "i",
              "on": [
                {
                  "left": "t.item_id",
                  "op": "eq",
                  "right": "i.item_id"
                }
              ]
            },
            {
              "type": "inner",
              "object_id": "table.dbo.charge_categories",
              "alias": "c",
              "on": [
                {
                  "left": "i.category_id",
                  "op": "eq",
                  "right": "c.category_id"
                }
              ]
            }
          ],
          "select": [
            {
              "field": "t.amount_cents",
              "aggregation": "sum",
              "as": "amount_cents"
            }
          ],
          "filters": {
            "logic": "and",
            "items": []
          },
          "group_by": [],
          "order_by": []
        },
        "dimensions": [
          "d.name",
          "c.name"
        ],
        "value": {
          "type": "column",
          "column": "amount_cents"
        },
        "total_rule": "recalculate"
      },
