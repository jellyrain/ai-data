  "metrics": {
    "items": [
      {
        "metric_id": "demo-admissions",
        "version": 1,
        "name": "入院人次（入院时间）",
        "description": "clinical-demo 演示指标，按 admitted_at 过滤日期；按 admission_id 去重计数。支持按科室名称分组，总计在完整授权范围重新计算。",
        "aliases": [
          "入院人次"
        ],
        "grain": "admissions",
        "deduplication_keys": [
          "t.admission_id"
        ],
        "date_basis": {
          "field": "t.admitted_at",
          "data_type": "datetime"
        },
        "query": {
          "type": "relational_query",
          "source_id": "clinical-demo",
          "from": {
            "object_id": "table.dbo.admissions",
            "alias": "t"
          },
          "joins": [
            {
              "type": "inner",
              "object_id": "table.dbo.departments",
              "alias": "d",
              "on": [
                {
                  "left": "t.department_id",
                  "op": "eq",
                  "right": "d.department_id"
                }
              ]
            }
          ],
          "select": [
            {
              "field": "t.admission_id",
              "aggregation": "count_distinct",
              "as": "count"
            }
          ],
          "filters": {
            "logic": "and",
            "items": []
          },
          "group_by": [],
          "order_by": []
        },
        "dimensions": [
          "d.name"
        ],
        "value": {
          "type": "column",
          "column": "count"
        },
        "total_rule": "recalculate"
      },
      {
